{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "authCluster",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "library-route": {
        "ClusterId": "libraryCluster",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/library/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "aiCluster",
        "CorsPolicy": "CorsPolicy",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "authServiceDestination": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "libraryCluster": {
        "Destinations": {
          "libraryServiceDestination": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "aiCluster": {
        "Destinations": {
          "aiServiceDestination": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
